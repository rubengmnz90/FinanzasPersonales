# Copiar a .env (no se versiona). Valores de ejemplo.
DATABASE_URL=postgres://postgres:CAMBIAR@localhost:5432/finanzas
TEST_DATABASE_URL=postgres://postgres:CAMBIAR@localhost:5432/finanzas_test
SEED_EMAIL=rubengmnz90@gmail.com
SEED_USER_PASSWORD=CAMBIAR
ALLOW_SIGNUP=false
PUBLIC_URL=http://localhost:3000   # con dominio: https://finanzas.vibralejana.com
DOMAIN=finanzas.vibralejana.com
PORT=3000
# Docker Compose (despliegue)
POSTGRES_PASSWORD=CAMBIAR
# DATABASE_URL=postgres://usuario:clave@host:5432/base   # solo si usas una base externa (p. ej. Supabase)
# Respaldo completo (pg_dump en .zip) por API: token para el servicio local (mín. 20 caracteres) y correo administrador
# BACKUP_TOKEN=genera-con-openssl-rand-hex-32
# ADMIN_EMAIL=rubengmnz90@gmail.com   # por defecto SEED_EMAIL

# Respaldo automático en la nube (Backblaze B2 u otro S3): 4 copias al día con retención GFS. Guía: docs/respaldo-automatico.md
# BACKUP_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# BACKUP_S3_KEY_ID=keyID-de-la-application-key
# BACKUP_S3_SECRET=applicationKey
# BACKUP_S3_BUCKET=nombre-del-bucket-privado
# Opcionales (valores por defecto): BACKUP_HOURS=0,6,12,18  BACKUP_TZ=America/Asuncion  BACKUP_S3_PREFIX=finanzas/
#   BACKUP_KEEP_RECENT_DAYS=2  BACKUP_KEEP_DAILY=7  BACKUP_KEEP_WEEKLY=4  BACKUP_KEEP_MONTHLY=12  BACKUP_S3_SSE=AES256
